<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<!-- src/main/resources -> mappers -> address.xml -->
<!-- XML Mapper -->
<mapper namespace="address">
	<select id="time" resultType="String">
		select sysdate from dual
	</select>
	
	<insert id="m1">
		insert into TBLADDRESS (seq, name, age, address, gender) VALUES (seqAddress.nextval,'홍길동', 20, '서울시 강남구 대치동', 'm');
	</insert>
	
	<!-- 넘어오는 값이 있으면 반드시 parameterType=""를 써야함 -->
	<update id="m2" parameterType="String">
		update tblAddress set
			age = age + 1
				where seq = #{seq}
	</update>
	
	<update id="m3" parameterType="java.util.HashMap">
	<!-- JDBC에선 ? 를 썼지만 MyBatis에서는 #바인딩을 해야한다 -->
		update tblAddress set
			name = #{name},
			age = #{age},
			address = #{address},
			gender = #{gender}
				where seq = #{seq}
	</update>
	<!-- 방금 넘어온 변수의 풀네임을 parameterType에 적어라 -->
	<update id="m4" parameterType="com.test.mybatis.model.AddressDto">
		update tblAddress set
			name = #{name},
			age = #{age},
			address = #{address},
			gender = #{gender}
				where seq = #{seq}
	</update>
	
	<select id="m5" parameterType="String" resultType="String">
	<!-- PK 하나 주면 이름을 가져오고 싶다고 했으니 -->
		select name from tblAddress where seq = #{seq}
	</select>
	
	<select id="m6" parameterType="String" resultType="adto">
		<!-- 매개변수는 똑같고 컬럼을 다 가져오기로 했으니까 * 사용 -->
		select * from tblAddress where seq = #{seq}
	</select>
	
	<!-- ListString이 아니고 그냥 String으로 반환하는 이유가 뭘까? -->
	<!-- template.selectList("m7")로 표현했기 때문에 구분 가능함 -->
	<!-- resultType은 레코드 1개를 담을 자료형을 지정 -->
	<!-- 어떻게 가져올지는 template.selectList 여기 메서드에서 정함 -->
	<select id="m7" resultType="String">
		select name from tblAddress
	</select>
	
	<select id="m8" resultType="adto">
		select * from tblAddress
	</select>
	<!--  
		MyBatis 바인딩 표현식
		- #{}: 값 바인딩, SQL의 데이터로 사용하는 바인딩
		<- 오라클의 ?와 동일
		
		- ${}: 문자열 바인딩, 굉장히 조심해서 써야함
		값이 숫자인지 문자열인지는 중요하지 않고 
		값을 있는 그대로 적음
		-> 동적으로 식별자 생성 또는 구문 생성
		
		값 바인딩을 where #{column} = #{word} 이렇게 하면
		select * from tblAddress where 'name' = '강아지'
		SQL문이 이렇게 됨
		컬럼 이름인 name에 ''이 붙으면 안됨	
	-->
	<select id="m9" parameterType="map" resultType="adto">
		<!-- 좋은 방식은 아니다 -->
		select * from tblAddress
			where ${column} = #{word}
	</select>
	
	<!--  
		인자가 단일값이면 #{변수명}(여기선 #{age})으로 쓰는게 나쁘진 않음
		하지만 예약어인 #{_parameter}로 쓰는걸 권장
		
		string은 java.lang.String의 별명(Alias)이다
		int는 java.lang.Integer의 별명(Alias)이다
		_int -> int(값형)
	-->
	<select id="m10" parameterType="java.lang.Integer" resultType="adto">
		select * from tblAddress
			<!-- 이 안에서는 xml 문법을 다 무시함 -->
			<![CDATA[
			where age >= #{_parameter}
			]]>
	</select>
	
	<select id="m11" parameterType="string" resultType="adto">
		
		<!-- MyBatis에서 권장하는 방법 -->
		<bind name="pattern" value="'%' + _parameter + '%'"/>
		select * from tblAddress
			where address like #{pattern}
		
		<!-- select * from tblAddress
			where address like '%' || #{_parameter} || '%' -->
	</select>
	
	<select id="m12" parameterType="string" resultType="adto">
		<!--  
			동적 쿼리
			- 상황에 따라 쿼리 구문의 일부를 다르게 만들어야 하는 경우
		-->
		<!-- select * from tblAddress where gender = 'm' -->
		<!--  
			MyBatis 동적 쿼리
			- <if>, <choose>, <foreach> 등 ..
		-->
		<!-- 상수에 ''를 쓰지 말자 -->
		<!-- <if test='_parameter == "m"'>
			select * from tblAddress where gender = 'm'
		</if>
		진짜 ''를 너무 쓰고 싶다면 뒤에 .toString()
		<if test="_parameter == 'f'.toString()">
			select * from tblAddress where gender = 'f'
		</if>
		<if test='_parameter == "all"'>
			select * from tblAddress
		</if> -->
		
		<!-- 효율적인 방법 -->
		<!-- select * from tblAddress
		<if test='_parameter == "m"'>
			where gender = 'm'
		</if>
		<if test="_parameter == 'f'.toString()">
			where gender = 'f'
		</if> -->
		
		<!-- 더 효율적인 방법 -->
		<!-- select * from tblAddress
		<if test='gender != "all"'>
			all 이 아니라면
			where gender = #{gender}
		</if> -->
		
		<!-- 다중 조건문 -->
		select * from tblAddress
			<choose>
				<when test='gender == "m"'>where gender = 'm'</when>
				<when test='gender == "f"'>where gender = 'f'</when>
				<otherwise></otherwise>
			</choose>
	</select>
	<select id="m13" parameterType="adto" resultType="adto">
		<!-- select * from tblAddress
			where 뒤에 조건이 없어져도 오류가 생기지 않도록
			SQL 실행 결과에 영향을 주지 않는 1 = 1 을 작성
			where 1 = 1
			<if test='age != null'>
			and age &lt; #{age}
			</if>
			<if test='gender != null'>
			and gender = #{gender}
			</if>
			<if test='address != null'>
			and address like '%' || #{address} || '%'
			</if> -->
		select * from tblAddress
			<where>
				<if test='age != null'>
				and age &lt; #{age}
				</if>
				<if test='gender != null'>
				and gender = #{gender}
				</if>
				<if test='address != null'>
				and address like '%' || #{address} || '%'
				</if>
			</where>
	</select>
	
	<!-- parameterType="list" 로 작성해도 됨 -->
	<select id="m14" parameterType="java.util.ArrayList" resultType="idto">
		<!-- select
			num, name, buseo, jikwi, basicpay as salary
		from tblInsa
			where buseo in (#{0}, #{1}, #{2}) -->
		select
			num, name, buseo, jikwi, basicpay as salary
		from tblInsa
			<where>
				<foreach collection="list" item="item" open="buseo in (" close=")" separator=",">#{item}</foreach>
			</where>
	</select>
	
	<insert id="add" parameterType="adto">
		insert into TBLADDRESS (seq, name, age, address, gender) VALUES (seqAddress.nextval, #{name}, #{age}, #{address}, #{gender});
	</insert>
	
	<insert id="addPoint">
		<selectKey order="BEFORE" resultType="string" keyProperty="aseq">
			select max(seq) from tblAddress
		</selectKey>
		
		insert into tblPoint (seq, point, aseq)
			values (seqPoint.nextval, 1000, #{aseq})
	</insert>
	
	<select id="m16" resultType="com.test.mybatis.model.AddressPointDto">
		select
    		a.seq, a.name, a.age, a.address, a.gender,
    		p.seq as pseq, p.point, p.aseq
    	from tblAddress a
    		left outer join tblPoint p
    			on a.seq = p.aseq
	</select>
	
	<!-- pdto가 어떻게 생겼는지를 알려주기 위한 pointMap -->
	<resultMap type="com.test.mybatis.model.PointDto" id="pointMap">
		<id column="pseq" property="seq" />
		<result column="point" property="point"/>
		<result column="aseq" property="aseq"/>
	</resultMap>
	
	<!-- resultType이 한개가 아니라서 resultMap을 사용해야 함 -->
	<!-- resultMap은 직접 만들어야 함 -->
	<resultMap type="adto" id="addressMap">
		<!--  
			컬럼과 세터를 직접 매핑해야 함
			JDBC에서의
			adto.setSeq(rs.getString("seq"))
			<- 이걸 매핑이라고 함
		-->
		<id column="seq" property="seq" /> <!-- PK에만 사용하는 태그인 id -->
		<!-- 일반 컬럼에 사용하는 태그인 result -->
		<!-- property는 멤버 변수이자 세터를 뜻함 -->
		<result column="name" property="name" />
		<result column="age" property="age" />
		<result column="address" property="address" />
		<result column="gender" property="gender" />
		<!-- 일단 위의 5개는 adto에 옮겨 담았고 -->
		<!-- 그 다음에 p.seq as pseq, p.point, p.aseq 얘네들도 담아야 하는데 -->
		<!-- 그건 또 자식 객체인 PointDto에 있다고 함 -->
		<!-- 근데 아직 pdto라는 이름만 알지 어떻게 생겼는지는 모름 -->
		
		<!-- 자식 객체 PointDto -->
		<!-- 자식 테이블, 즉 포인트를 저장할 resultMap을 하나 더 만들어야 함 -->
		<!-- 그게 pdto가 어떻게 생겼는지를 알려주기 위한 pointMap -->
		<association property="pdto" resultMap="pointMap"></association>
	</resultMap>
	
	<!-- resultType에는 이미 정해진 클래스 이름을 적는것 -->
	<!-- resultType이 한개가 아니라서 resultMap을 사용해야 함 -->
	<select id="m17" resultMap="addressMap">
		select
    		a.seq, a.name, a.age, a.address, a.gender,
    		p.seq as pseq, p.point, p.aseq
    	from tblAddress a
    		left outer join tblPoint p
    			on a.seq = p.aseq
	</select>
	
	<!-- 1대 N 관계 에서의 조인인 m18 -->
	<resultMap type="com.test.mybatis.model.ProjectDto" id="projectMap">
		<id column="seq" property="seq" />
		<result column="pname" property="name" />
		<result column="location" property="location" />
		<result column="inum" property="num" />
	</resultMap>
	
	<resultMap type="com.test.mybatis.model.InsaDto" id="insaMap">
		<id column="num" property="num" />
		<result column="name" property="name" />
		<result column="buseo" property="buseo" />
		<result column="jikwi" property="jikwi" />
		<result column="basicpay" property="salary" />
		
		<collection property="project" resultMap="projectMap"></collection>
	</resultMap>
	
	<select id="m18" resultMap="insaMap">
		select
    		a.NUM, a.NAME, a.BUSEO, a.JIKWI, a.BASICPAY as salary,
    		p.seq, p.NAME as pname, p.location, p.num as inum
		from TBLINSA a
    		left outer join tblProject p
        		on a.NUM = p.NUM
        			where a.buseo = '홍보부'
        				order by a.num asc
	</select>
</mapper>